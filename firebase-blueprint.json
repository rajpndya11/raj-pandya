{
  "entities": {
    "Project": {
      "title": "Project Case Study",
      "description": "Portfolio case study with modular blocks, multiple wireframes, prototype links, and metrics.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the project"
        },
        "title": {
          "type": "string",
          "description": "Project title"
        },
        "slug": {
          "type": "string",
          "description": "URL slug for project detail"
        },
        "subtitle": {
          "type": "string",
          "description": "Case study subtitle or tagline"
        },
        "shortDescription": {
          "type": "string",
          "description": "Summary for portfolio project cards"
        },
        "category": {
          "type": "string",
          "description": "Domain category: Core PM, Growth & Optimization, AI Products, 0 to 1"
        },
        "role": {
          "type": "string",
          "description": "Primary role e.g. Lead Product Manager"
        },
        "timeline": {
          "type": "string",
          "description": "Project duration or year"
        },
        "industry": {
          "type": "string",
          "description": "Sector e.g. PropTech, FinTech, E-Commerce, EdTech"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "published", "archived"],
          "description": "Publishing status"
        },
        "featured": {
          "type": "boolean",
          "description": "Whether to highlight on homepage"
        },
        "order": {
          "type": "number",
          "description": "Display order index"
        },
        "coverImage": {
          "type": "string",
          "description": "Thumbnail and hero cover image URL"
        },
        "videoUrl": {
          "type": "string",
          "description": "Demo video or walkthrough URL"
        },
        "overview": {
          "type": "string",
          "description": "Executive overview"
        },
        "problem": {
          "type": "string",
          "description": "Problem statement & user pain points"
        },
        "objectives": {
          "type": "string",
          "description": "Key business & user objectives"
        },
        "userResearch": {
          "type": "string",
          "description": "User research and insights"
        },
        "targetAudience": {
          "type": "string",
          "description": "Target personas"
        },
        "strategy": {
          "type": "string",
          "description": "Product strategy & prioritization"
        },
        "solution": {
          "type": "string",
          "description": "Solution breakdown & architecture"
        },
        "experimentation": {
          "type": "string",
          "description": "A/B testing and experimentation"
        },
        "outcome": {
          "type": "string",
          "description": "Business impact & outcomes"
        },
        "learnings": {
          "type": "string",
          "description": "Key retrospective learnings"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "title", "slug", "status"]
    },
    "SiteProfile": {
      "title": "Site Profile & Content",
      "description": "Global website content including bio, hero, contact, and skills.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Profile document ID"
        },
        "name": {
          "type": "string",
          "description": "Candidate name"
        },
        "eyebrow": {
          "type": "string",
          "description": "Hero eyebrow title"
        },
        "headline": {
          "type": "string",
          "description": "Hero headline"
        },
        "bio": {
          "type": "string",
          "description": "About me biography"
        },
        "quote": {
          "type": "string",
          "description": "Philosophy quote"
        },
        "quoteAuthor": {
          "type": "string",
          "description": "Quote author"
        },
        "photoUrl": {
          "type": "string",
          "description": "Hero portrait image URL"
        },
        "photoTagline": {
          "type": "string",
          "description": "Hero portrait badge tagline"
        },
        "email": {
          "type": "string",
          "description": "Contact email"
        },
        "linkedin": {
          "type": "string",
          "description": "LinkedIn profile URL"
        },
        "location": {
          "type": "string",
          "description": "Current location"
        },
        "ctaText": {
          "type": "string",
          "description": "Hero primary CTA button text"
        },
        "ctaLink": {
          "type": "string",
          "description": "Hero primary CTA destination"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of update"
        }
      },
      "required": ["id", "name"]
    },
    "Experience": {
      "title": "Work Experience Item",
      "description": "Career position and accomplishments.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique experience ID"
        },
        "role": {
          "type": "string",
          "description": "Job title"
        },
        "company": {
          "type": "string",
          "description": "Company or organization"
        },
        "period": {
          "type": "string",
          "description": "Employment period"
        },
        "location": {
          "type": "string",
          "description": "Work location"
        },
        "summary": {
          "type": "string",
          "description": "High level overview"
        },
        "order": {
          "type": "number",
          "description": "Display sort order"
        }
      },
      "required": ["id", "role", "company"]
    },
    "MediaAsset": {
      "title": "Media & Document Asset",
      "description": "Uploaded image, wireframe, PDF or design asset.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Asset ID"
        },
        "name": {
          "type": "string",
          "description": "Original file name"
        },
        "url": {
          "type": "string",
          "description": "Asset data URL or storage URL"
        },
        "type": {
          "type": "string",
          "description": "MIME type e.g. image/png, application/pdf"
        },
        "size": {
          "type": "number",
          "description": "File size in bytes"
        },
        "caption": {
          "type": "string",
          "description": "Optional caption or description"
        },
        "projectId": {
          "type": "string",
          "description": "Associated project ID if applicable"
        },
        "createdAt": {
          "type": "string",
          "description": "Upload timestamp"
        }
      },
      "required": ["id", "name", "url"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/Project"
      },
      "description": "Project case studies. Public read for published projects; admin read/write."
    },
    "/site_content/{contentId}": {
      "schema": {
        "$ref": "#/entities/SiteProfile"
      },
      "description": "Global website content. Public read; admin read/write."
    },
    "/experiences/{experienceId}": {
      "schema": {
        "$ref": "#/entities/Experience"
      },
      "description": "Career and work experience entries. Public read; admin read/write."
    },
    "/media_assets/{assetId}": {
      "schema": {
        "$ref": "#/entities/MediaAsset"
      },
      "description": "Media library assets, wireframes, and uploaded documents. Admin read/write."
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/SiteProfile"
      },
      "description": "Admin authorization registry."
    }
  }
}
